# Base de datos PostgreSQL
# En Docker usa: postgresql://sitti_user:sitti_password@postgres:5432/sitti_db
# En local usa: postgresql://sitti_user:sitti_password@localhost:5432/sitti_db
DATABASE_URL="postgresql://user:password@host:5432/sitti_db"

# Node environment
NODE_ENV="development"

# Server port
PORT=3000

# JWT (será configurado después)
# JWT_SECRET="your-secret-key"

# Cloudinary o servicio de almacenamiento (será configurado después)
# UPLOAD_URL="https://..."
